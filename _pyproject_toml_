[project]
name = "crm-app"
version = "0.0.1"
description = "Высоконагруженное API на FastAPI"
readme = "README.md"
requires-python = ">=3.11"
authors = [
    { name = "Ваше Имя", email = "your.email@example.com" }
]
# Основные зависимости для Production (то, что поедет на сервер)
dependencies = [
    "alembic>=1.18.4",
    "bcrypt==4.0.1",
    "fastapi>=0.136.3",
    "passlib>=1.7.4",
    "psycopg2>=2.9.12",
    "pydantic>=2.13.4",
    "pydantic-settings>=2.14.1",
    "pyjwt[crypto]>=2.13.0",
    "python-multipart>=0.0.29",
    "sqlalchemy>=2.0.50",
]

# Зависимости для разработки и тестов (не ставятся на Production)
[dependency-groups]
dev = [
   
]

# --- Конфигурация инструментов разработки ---

[tool.ruff]
line-length = 88
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP"] # Стилистика, ошибки, импорты, bug-bear, модернизация
ignore = []

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]

[tool.mypy]
python_version = "3.11"
strict = true
ignore_missing_imports = true

[tool.setuptools]
packages = ["app"]
